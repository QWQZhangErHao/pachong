# Pachong Environment Configuration
PACHONG_ENV=development

# PostgreSQL
PACHONG_DATABASE__POSTGRES_DSN=postgresql+asyncpg://pachong:pachong@localhost:5432/pachong

# MongoDB
PACHONG_DATABASE__MONGO_URI=mongodb://localhost:27017

# Redis
PACHONG_DATABASE__REDIS_URI=redis://localhost:6379/0

# MinIO / S3
PACHONG_S3__ENDPOINT=http://localhost:9000
PACHONG_S3__ACCESS_KEY=minioadmin
PACHONG_S3__SECRET_KEY=minioadmin
PACHONG_S3__BUCKET=pachong-raw
PACHONG_S3__REGION=us-east-1

# Kafka
PACHONG_QUEUE__KAFKA_BROKERS=["localhost:9092"]

# Logging
PACHONG_LOG_LEVEL=DEBUG
